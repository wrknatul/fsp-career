# FSP.Career: environment variables.
#
#   cp .env.example .env
#
# `docker compose up --build` works even without .env: every variable has a
# default. This file only lists what you can change. In the repository there is
# only .env.example; the real .env is ignored by git.
#
# Do not put the "$" character in values: Docker Compose treats it as the start
# of a variable reference.

# ---------------------------------------------------------------------------
# Application (SPEC section 8)
# ---------------------------------------------------------------------------

# JWT signing secret (HS256).
# !!! MUST BE REPLACED WITH A NEW VALUE ON A SERVER !!!
# Anyone who knows this value can forge a login token for any user.
# Generate a new one:  openssl rand -hex 32
# Changing it logs everybody out.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Token lifetime in minutes (720 = 12 hours).
JWT_TTL_MINUTES=720

# Create demo data (24 registry athletes, 30 candidates, 3 employers, 6
# vacancies, 6 offers) when the database is empty at startup. Reset by hand:
#   make seed-reset
SEED_DEMO_DATA=true

# Pause between two attempts of the same express test, in minutes. The
# application default is 1440 (a day); Docker Compose uses 10 so a demo can
# retake a test. For a public stand set 1440.
TEST_COOLDOWN_MINUTES=10

# Maximum resume file size in bytes (2097152 = 2 MB). The web container
# accepts bodies up to 3 MB (frontend/nginx.conf), so do not go above that.
MAX_UPLOAD_BYTES=2097152

# FSP registry source. In this MVP only `mock` exists: the registry is modeled.
FSP_REGISTRY_MODE=mock

# Public read-only mock route GET /api/v1/fsp-mock/athletes/{fsp_id}.
# It serves invented data only; it can be switched off on a stand.
FSP_MOCK_ROUTES_ENABLED=true

# Allowed browser origins for CORS: a comma-separated list or a JSON array.
# NOT needed with Docker Compose: the browser talks to the API through the web
# container on the same origin. When unset, the application allows
# localhost/127.0.0.1 on ports 5173 and 8088. Uncomment only if the frontend is
# opened from another origin.
# CORS_ORIGINS=https://fsp.example.com,http://localhost:5173

# Database URL of the backend.
# Docker Compose builds it itself from POSTGRES_* below, so do not set it for
# Docker. Needed only when you run the backend without Docker; if it is not
# set, the application uses SQLite (sqlite:///./dev.sqlite3 in backend/).
# Example for the PostgreSQL from Compose (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://fsp:fsp_dev_password@localhost:5544/fsp_career

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# ---------------------------------------------------------------------------

POSTGRES_USER=fsp
POSTGRES_DB=fsp_career

# !!! MUST BE REPLACED WITH A NEW VALUE ON A SERVER !!!
# Use letters and digits only: the password goes into DATABASE_URL, where
# special characters would need URL-encoding.
# It is applied only when the database volume is created. Changing it later
# does not change the password inside an existing database.
POSTGRES_PASSWORD=change-me-use-letters-and-digits

# ---------------------------------------------------------------------------
# Ports and bind addresses on the host (Docker Compose)
# ---------------------------------------------------------------------------
# 5432 and 8000 are intentionally not used: they are often busy locally.

# Web (nginx with the built frontend): http://localhost:8088
WEB_PORT=8088
# API: http://localhost:8100 (docs: /api/docs)
API_PORT=8100
# PostgreSQL from outside the containers.
DB_PORT=5544

# Which host address each port listens on.
# Defaults: web and API on all interfaces, database on localhost only.
# On a server behind a reverse proxy (see README) set web and API to 127.0.0.1.
# WEB_BIND=127.0.0.1
# API_BIND=127.0.0.1
# DB_BIND=127.0.0.1
